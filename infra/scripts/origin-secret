#!/usr/bin/env bash
# From search-front/infra/scripts/origin-secret. What differs: the names
# (`vizualisation-origin-secret-<env>`, the Worker `vizualisation-<env>`),
# the hosts, and `check` asks the host's /healthz, not / (dev's / is behind
# the password gate and answers 401; /healthz is behind the origin guard
# only, so its 200 says the Worker's value is the service's).
#
# The origin secret of vizualisation (design v4): the value the
# Cloudflare Worker sends as `x-origin-auth` and the service requires. It
# lives in Secret Manager (`vizualisation-origin-secret-<env>`, read by the
# service) and in the Worker's secret store (binding `ORIGIN_AUTH`). Neither
# is in tofu state: tofu creates the empty secret and the Worker, this script
# fills them.
#
#   origin-secret create <dev|prod>   generate the value, add it as the
#                                     secret's first version (does nothing
#                                     when a version exists)
#   origin-secret push   <dev|prod>   copy the latest version into the
#                                     Worker (Cloudflare API)
#   origin-secret check  <dev|prod>   print OK, or "not OK" and why
#
# The value is never printed and never an argument: it travels on stdin
# (`gcloud ... --data-file=-`, `curl --config -`). `push` needs
# CLOUDFLARE_API_TOKEN in the environment (from the keychain, README).
# `push` is re-run after any `tofu apply` that touches the Worker (the
# provider can drop a secret it does not declare). Rotation (infra/README.md):
# add a new version by hand, `push` it (the Worker now sends the new value),
# then start a new revision that reads it; until that revision serves the
# service answers the Worker with 403 (no two-value overlap).
set -euo pipefail

PROJECT=${PROJECT:-palicanon-app}
ACCOUNT=${CLOUDFLARE_ACCOUNT_ID:-c0690c72f1b7c85737052c3a9ebac154}

usage() {
  echo "usage: origin-secret <create|push|check> <dev|prod>" >&2
  exit 2
}

cmd=${1:-}
env_name=${2:-}
case "$cmd" in create | push | check) ;; *) usage ;; esac
case "$env_name" in
  dev) host=${HOST:-map.dev.palicanon.app} ;;
  prod) host=${HOST:-map.palicanon.app} ;;
  *) usage ;;
esac
secret="vizualisation-origin-secret-$env_name"
worker="vizualisation-$env_name"
api="https://api.cloudflare.com/client/v4/accounts/$ACCOUNT/workers/scripts/$worker/secrets"

has_version() {
  local found
  found=$(gcloud secrets versions list "$secret" --project "$PROJECT" --filter 'state=enabled' --limit 1 --format 'value(name)')
  [ -n "$found" ]
}

# A curl call whose arguments are a config on stdin: neither the Cloudflare
# token nor the value is ever in an argv. Extra config lines are the
# arguments after the method.
cf_call() { # cf_call METHOD [CONFIG_LINE...] → curl's stdout
  local method=$1
  shift
  : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is not set (README: the keychain)}"
  printf '%s\n' \
    "url = \"$api\"" \
    "request = \"$method\"" \
    "header = \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\"" \
    'header = "Content-Type: application/json"' \
    'silent' 'show-error' "$@" | curl --config -
}

do_create() {
  if has_version; then
    echo "origin-secret: $secret already has a version; nothing to do"
    return 0
  fi
  openssl rand -hex 32 | gcloud secrets versions add "$secret" --project "$PROJECT" --data-file=- >/dev/null
  echo "origin-secret: $secret created (the value is not shown)"
}

do_push() {
  : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is not set (README: the keychain)}"
  local value code
  value=$(gcloud secrets versions access latest --secret "$secret" --project "$PROJECT")
  [ -n "$value" ] || { echo "origin-secret: $secret has no value; run create first" >&2; return 1; }
  # The value goes into a JSON string inside a curl config string: only
  # characters that need no escaping in either (`create` makes hex).
  case "$value" in *[!A-Za-z0-9+/=_-]*) echo "origin-secret: the value has characters this script does not escape" >&2; return 1 ;; esac
  code=$(cf_call PUT \
    "data = \"{\\\"name\\\":\\\"ORIGIN_AUTH\\\",\\\"text\\\":\\\"$value\\\",\\\"type\\\":\\\"secret_text\\\"}\"" \
    'output = "/dev/null"' 'write-out = "%{http_code}"')
  # 200: the secret replaced; 201: it was new on the Worker (the first push after
  # an apply). Both are a success (search-front task 014).
  if [ "$code" = "200" ] || [ "$code" = "201" ]; then
    echo "origin-secret: $worker has the secret (HTTP $code)"
  else
    echo "origin-secret: Cloudflare answered HTTP $code; $worker was not updated" >&2
    return 1
  fi
}

# OK, or "not OK" and the first reason. Prints no value.
do_check() {
  local code
  has_version || { echo "not OK: $secret has no enabled version (run create)"; return 1; }
  cf_call GET | grep -Eq '"name": *"ORIGIN_AUTH"' \
    || { echo "not OK: the Worker $worker has no ORIGIN_AUTH secret (run push)"; return 1; }
  code=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' "https://$host/healthz") || code=000
  case "$code" in
    200) echo "OK" ;;
    500) echo "not OK: https://$host/healthz answered HTTP 500 (the Worker has no secret: run push)"; return 1 ;;
    403) echo "not OK: https://$host/healthz answered HTTP 403 (the service refuses the Worker's value: run push, or roll a revision)"; return 1 ;;
    *) echo "not OK: https://$host/healthz answered HTTP $code"; return 1 ;;
  esac
}

case "$cmd" in
  create) do_create ;;
  push) do_push ;;
  check) do_check ;;
esac
