#!/usr/bin/env bash
# From search-front/infra/scripts/origin-secret. What differs: the name
# (`vizualisation-origin-secret-prod`) and the scope: dev and the Cloudflare
# Worker that sent the value are gone (task 022), so there is no `push` and
# no host check; only prod's Cloud Run secret is left.
#
# The origin secret of vizualisation (design v4): the value the Cloud Run
# service requires as `x-origin-auth` (403 without it). It lives in Secret
# Manager (`vizualisation-origin-secret-prod`, read by the service) and is
# not in tofu state: tofu creates the empty secret, this script fills it.
#
#   origin-secret create prod   generate the value, add it as the secret's
#                               first version (does nothing when a version
#                               exists)
#   origin-secret check  prod   print OK, or "not OK" and why (the secret
#                               has an enabled version)
#
# The value is never printed and never an argument: it travels on stdin
# (`gcloud ... --data-file=-`). The script makes no network call besides
# `gcloud`. Rotation is not done by this script (infra/README.md).
set -euo pipefail

PROJECT=${PROJECT:-palicanon-app}

usage() {
  echo "usage: origin-secret <create|check> <prod>" >&2
  exit 2
}

cmd=${1:-}
env_name=${2:-}
case "$cmd" in create | check) ;; *) usage ;; esac
case "$env_name" in prod) ;; *) usage ;; esac
secret="vizualisation-origin-secret-$env_name"

has_version() {
  local found
  found=$(gcloud secrets versions list "$secret" --project "$PROJECT" --filter 'state=enabled' --limit 1 --format 'value(name)')
  [ -n "$found" ]
}

do_create() {
  if has_version; then
    echo "origin-secret: $secret already has a version; nothing to do"
    return 0
  fi
  openssl rand -hex 32 | gcloud secrets versions add "$secret" --project "$PROJECT" --data-file=- >/dev/null
  echo "origin-secret: $secret created (the value is not shown)"
}

# OK, or "not OK" and the reason. Prints no value.
do_check() {
  has_version || { echo "not OK: $secret has no enabled version (run create)"; return 1; }
  echo "OK"
}

case "$cmd" in
  create) do_create ;;
  check) do_check ;;
esac
